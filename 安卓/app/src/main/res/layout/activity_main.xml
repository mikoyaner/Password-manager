<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="搜索标题/网址/用户名/备注…"
        android:inputType="text"
        android:imeOptions="actionSearch" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/add" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="新增" />
        <Button android:id="@+id/sync" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="同步" />
        <Button android:id="@+id/exportCsv" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="导出" />
        <Button android:id="@+id/switchVault" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="切换库" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/list"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp">
            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:padding="8dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/edit" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="编辑" />
        <Button android:id="@+id/delete" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="删除" />
        <Button android:id="@+id/copy_user" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="复制用户名" />
        <Button android:id="@+id/copy_pass" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="复制密码" />
        <Button android:id="@+id/copy_key" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="复制Key" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="就绪"
        android:textSize="12sp"
        android:paddingTop="6dp" />

</LinearLayout>
