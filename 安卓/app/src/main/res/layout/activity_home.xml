<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="密码管理器"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择要打开的本地库，或新建一库 / 登录服务器拉取。"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/open_local"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开本地库" />

    <Button
        android:id="@+id/new_local"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="新建本地库" />

    <Button
        android:id="@+id/pull_cloud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="登录服务器拉取" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="本机密码库"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/vault_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button android:id="@+id/refresh" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="刷新" />
        <Button android:id="@+id/menu_settings" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="设置" />
    </LinearLayout>

</LinearLayout>
