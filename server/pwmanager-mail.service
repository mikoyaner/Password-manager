[Unit]
Description=PwdMgr forgot-password mail worker (one shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pwmanager
Group=pwmanager
WorkingDirectory=/opt/pwmanager/server
EnvironmentFile=-/opt/pwmanager/server/admin.env
ExecStart=/opt/pwmanager/venv/bin/python mail_worker.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
