[Unit]
Description=PwdMgr forgot-password mail worker (one shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pwmanager
Group=pwmanager
WorkingDirectory=/opt/pwmanager/server
Environment=PWMGR_DB=/opt/pwmanager/server/data/pwmanager.db
Environment=PWMGR_DB=/opt/pwmanager/server/data/pwmanager.db
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/opt/pwmanager/mail.env
ExecStart=/opt/pwmanager/venv/bin/python mail_worker.py
NoNewPrivileges=yes
ProtectSystem=strict
# 重置密码要写数据库：数据目录是本单元唯一可写点
ReadWritePaths=/opt/pwmanager/server/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
